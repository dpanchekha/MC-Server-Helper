{
  "name": "mc-server-helper",
  "version": "0.2.5",
  "description": "A friendly desktop manager for local Minecraft servers.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "server",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mcserverhelper.app",
    "productName": "MC Server Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "artifactName": "MC-Server-Helper-Windows-Setup-${version}.${ext}",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "artifactName": "MC-Server-Helper-macOS-${arch}-${version}.${ext}",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MC Server Helper"
    }
  }
}
